{
  "ai": {
    "provider": "openai",
    "model": "kimi-k3",
    "base_url": "https://api.moonshot.cn/v1",
    "api_key_env": "MOONSHOT_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 7,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 7,
        "topic_dedup": true
      },
      "bio-research": {
        "threshold": 7,
        "topic_dedup": true
      },
      "china-real-estate": {
        "threshold": 7,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "software-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "tech-news"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "semiconductors",
        "profile": "tech-news"
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux-kernel",
        "profile": "tech-news"
      },
      {
        "name": "Nature Structural & Molecular Biology",
        "url": "https://www.nature.com/nsmb.rss",
        "enabled": true,
        "category": "structural-biology",
        "profile": "bio-research",
        "fetch_limit": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "Nature Methods",
        "url": "https://www.nature.com/nmeth.rss",
        "enabled": true,
        "category": "omics-methods",
        "profile": "bio-research",
        "fetch_limit": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "Nature Chemical Biology",
        "url": "https://www.nature.com/nchembio.rss",
        "enabled": true,
        "category": "chemical-biology",
        "profile": "bio-research",
        "fetch_limit": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "bioRxiv Genomics & Bioinformatics",
        "url": "https://connect.biorxiv.org/biorxiv_xml.php?subject=genomics+bioinformatics",
        "enabled": true,
        "category": "omics-preprint",
        "profile": "bio-research",
        "fetch_limit": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "bioRxiv Biophysics & Biochemistry",
        "url": "https://connect.biorxiv.org/biorxiv_xml.php?subject=biophysics+biochemistry",
        "enabled": true,
        "category": "structural-preprint",
        "profile": "bio-research",
        "fetch_limit": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "Endpoints News",
        "url": "https://endpts.com/feed/",
        "enabled": true,
        "category": "pharma-industry",
        "profile": "auto",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Fierce Biotech",
        "url": "https://www.fiercebiotech.com/rss/xml",
        "enabled": true,
        "category": "pharma-industry",
        "profile": "auto",
        "content_extractor": "trafilatura"
      },
      {
        "name": "BioPharma Dive",
        "url": "https://www.biopharmadive.com/feeds/news/",
        "enabled": true,
        "category": "pharma-industry",
        "profile": "auto",
        "content_extractor": "trafilatura"
      },
      {
        "name": "STAT News",
        "url": "https://www.statnews.com/feed/",
        "enabled": true,
        "category": "pharma-industry",
        "profile": "auto",
        "content_extractor": "trafilatura"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 3
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 10,
          "profile": [
            "tech-news",
            "finance-news"
          ]
        }
      ]
    },
    "google_news": {
      "enabled": true,
      "query": "中国 房地产 (政策 OR 限购 OR 房贷 OR 住房公积金 OR 商品房销售 OR 房价 OR 房地产开发投资 OR 土地成交)",
      "language": "zh",
      "country": "CN",
      "max_results": 20,
      "category": "china-real-estate",
      "profile": "china-real-estate"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 7,
    "group_by": "profile",
    "category_groups": {
      "bio-research": {
        "limit": 1,
        "categories": ["bio-research"]
      },
      "china-real-estate": {
        "limit": 2,
        "categories": ["china-real-estate"]
      }
    },
    "profile_order": [
      "tech-news",
      "tech-blog",
      "bio-research",
      "china-real-estate",
      "finance-news"
    ],
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
